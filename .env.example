DATABASE_URL=postgresql://aurix:aurix_dev@localhost:5432/aurix
PAYLOAD_SECRET=your-long-random-secret-min-32-chars

# Form emails. On Vercel, install Resend from Marketplace or set RESEND_API_KEY manually.
RESEND_API_KEY=
LEAD_EMAIL_TO=info@aurixdanismanlik.com
LEAD_EMAIL_FROM="AURIX Web <onboarding@resend.dev>"

# Public pages stay static/fast by default. Set true only when CMS-driven public reads are needed.
PAYLOAD_PUBLIC_READS=false

# Optional DB reachability tuning for Payload-backed reads/forms.
PAYLOAD_DB_CHECK_CACHE_MS=30000
PAYLOAD_DB_CONNECT_TIMEOUT_MS=120

# Optional hard switch for maintenance/static-only mode.
# PAYLOAD_DISABLED=true
